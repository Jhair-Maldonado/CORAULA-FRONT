# Plantilla de variables de entorno para desarrollo local.
# Copia este archivo a `.env.local` (no versionado) y ajusta los valores.
# Reinicia `npm run dev` después de cambiar cualquier variable.

# URL base del backend, incluyendo el prefijo `/api`.
# `src/services/httpClient.ts` agrega rutas como `/v1/management/...`.
# Valor para el backend local (Spring Boot en el puerto 8080):
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Activa o desactiva los datos simulados (mocks).
# Solo el valor exacto `false` usa el backend real; si la variable falta
# o tiene cualquier otro valor, se activan los mocks.
NEXT_PUBLIC_USE_MOCKS=false