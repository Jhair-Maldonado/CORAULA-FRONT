# Plantilla de variables de entorno para desarrollo local.
# Copia este archivo a `.env.local` (no versionado) y ajusta los valores.
# Reinicia `npm run dev` después de cambiar cualquier variable.

# Modo de ejecución: MOCK | LOCAL | PRODUCTION
# - MOCK: sin backend; login con usuarios demo (*@demo.local) y datos simulados.
#         Se activa con `npm run dev:mock`.
# - LOCAL: backend local (Spring Boot). Es el modo por defecto de `npm run dev`.
# - PRODUCTION: backend desplegado. Es el modo por defecto de `next build`
#   y el único permitido en Vercel (Production).
# Nunca es MOCK por defecto. No apuntes el frontend local a producción.
NEXT_PUBLIC_APP_MODE=LOCAL

# URL del backend en modo LOCAL, con el prefijo `/api`.
# Si falta, se usa http://localhost:8080/api.
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:8080/api

# URL del backend en modo PRODUCTION, con el prefijo `/api`.
# Obligatoria en PRODUCTION; en Vercel se define en Environment Variables.
# NEXT_PUBLIC_API_URL=https://<backend-desplegado>/api

# Latencia simulada en modo MOCK, en milisegundos (por defecto 300).
# NEXT_PUBLIC_MOCK_LATENCY_MS=300

# OBSOLETA: se mantiene solo por compatibilidad durante la transición.
# Usa NEXT_PUBLIC_APP_MODE. No la combines con NEXT_PUBLIC_APP_MODE=MOCK:
# esa contradicción detiene el arranque.
# NEXT_PUBLIC_USE_MOCKS=false
